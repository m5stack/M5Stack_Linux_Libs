# Kconfig file for LVGL v9.2.0
# sed -i 's/LV_/V9_3_LV_/g; s/LVGL_/V9_3_LVGL_/g' Kconfig
menu "LVGL configuration"

	# Define CONFIG_V9_3_LV_CONF_SKIP so we can use LVGL
	# without lv_conf.h file, the lv_conf_internal.h and
	# lv_conf_kconfig.h files are used instead.
	config V9_3_LV_CONF_SKIP
		bool "Check this to not use custom lv_conf.h"
		default y

	config V9_3_LV_CONF_MINIMAL
		bool "LVGL minimal configuration"

	menu "Color Settings"
		choice V9_3_LV_COLOR_DEPTH
			prompt "Color depth"
			default V9_3_LV_COLOR_DEPTH_16
			help
				Color depth to be used.

			config V9_3_LV_COLOR_DEPTH_32
				bool "32: XRGB8888"
			config V9_3_LV_COLOR_DEPTH_24
				bool "24: RGB888"
			config V9_3_LV_COLOR_DEPTH_16
				bool "16: RGB565"
			config V9_3_LV_COLOR_DEPTH_8
				bool "8: RGB232"
			config V9_3_LV_COLOR_DEPTH_1
				bool "1: 1 byte per pixel"
		endchoice

		config V9_3_LV_COLOR_DEPTH
			int
			default 1 if V9_3_LV_COLOR_DEPTH_1
			default 8 if V9_3_LV_COLOR_DEPTH_8
			default 16 if V9_3_LV_COLOR_DEPTH_16
			default 24 if V9_3_LV_COLOR_DEPTH_24
			default 32 if V9_3_LV_COLOR_DEPTH_32
	endmenu

	menu "Memory Settings"
		choice
			prompt "Malloc functions source"
			default V9_3_LV_USE_BUILTIN_MALLOC

		config V9_3_LV_USE_BUILTIN_MALLOC
			bool "LVGL's built in implementation"

		config V9_3_LV_USE_CLIB_MALLOC
			bool "Standard C functions malloc/realloc/free"

		config V9_3_LV_USE_MICROPYTHON_MALLOC
			bool "MicroPython functions malloc/realloc/free"

		config V9_3_LV_USE_RTTHREAD_MALLOC
			bool "RTThread functions malloc/realloc/free"

		config V9_3_LV_USE_CUSTOM_MALLOC
			bool "Implement the functions externally"

		endchoice # "Malloc functions"

		choice
			prompt "String functions source"
			default V9_3_LV_USE_BUILTIN_STRING

		config V9_3_LV_USE_BUILTIN_STRING
			bool "LVGL's built in implementation"

		config V9_3_LV_USE_CLIB_STRING
			bool "Standard C functions memcpy/memset/strlen/strcpy"

		config V9_3_LV_USE_CUSTOM_STRING
			bool "Implement the functions externally"

		endchoice # "String functions"

		choice
			prompt "Sprintf functions source"
			default V9_3_LV_USE_BUILTIN_SPRINTF

		config V9_3_LV_USE_BUILTIN_SPRINTF
			bool "LVGL's built in implementation"

		config V9_3_LV_USE_CLIB_SPRINTF
			bool "Standard C functions vsnprintf"

		config V9_3_LV_USE_CUSTOM_SPRINTF
			bool "Implement the functions externally"

		endchoice # "Sprintf functions"

		config V9_3_LV_MEM_SIZE_KILOBYTES
			int "Size of the memory used by `lv_malloc()` in kilobytes (>= 2kB)"
			default 64
			depends on V9_3_LV_USE_BUILTIN_MALLOC

		config V9_3_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES
			int "Size of the memory expand for `lv_malloc()` in kilobytes"
			default 0
			depends on V9_3_LV_USE_BUILTIN_MALLOC

		config V9_3_LV_MEM_ADR
			hex "Address for the memory pool instead of allocating it as a normal array"
			default 0x0
			depends on V9_3_LV_USE_BUILTIN_MALLOC

	endmenu

	menu "HAL Settings"
		config V9_3_LV_DEF_REFR_PERIOD
			int "Default refresh period (ms)"
			default 33
			help
				Default display refresh, input device read and animation step period.

		config V9_3_LV_DPI_DEF
			int "Default Dots Per Inch (in px/inch)"
			default 130
			help
				Used to initialize default sizes such as widgets sized, style paddings.
				(Not so important, you can adjust it to modify default sizes and spaces)
	endmenu

	menu "Operating System (OS)"
		choice V9_3_LV_USE_OS
			prompt "Default operating system to use"
			default V9_3_LV_OS_NONE

			config V9_3_LV_OS_NONE
				bool "0: NONE"
			config V9_3_LV_OS_PTHREAD
				bool "1: PTHREAD"
			config V9_3_LV_OS_FREERTOS
				bool "2: FREERTOS"
			config V9_3_LV_OS_CMSIS_RTOS2
				bool "3: CMSIS_RTOS2"
			config V9_3_LV_OS_RTTHREAD
				bool "4: RTTHREAD"
			config V9_3_LV_OS_WINDOWS
				bool "5: WINDOWS"
			config V9_3_LV_OS_MQX
				bool "6: MQX"
			config V9_3_LV_OS_CUSTOM
				bool "255: CUSTOM"
		endchoice

		config V9_3_LV_USE_OS
			int
			default 0 if V9_3_LV_OS_NONE
			default 1 if V9_3_LV_OS_PTHREAD
			default 2 if V9_3_LV_OS_FREERTOS
			default 3 if V9_3_LV_OS_CMSIS_RTOS2
			default 4 if V9_3_LV_OS_RTTHREAD
			default 5 if V9_3_LV_OS_WINDOWS
			default 6 if V9_3_LV_OS_MQX
			default 255 if V9_3_LV_OS_CUSTOM

		config V9_3_LV_OS_CUSTOM_INCLUDE
			string "Custom OS include header"
			default "stdint.h"
			depends on V9_3_LV_OS_CUSTOM

        config V9_3_LV_USE_FREERTOS_TASK_NOTIFY
            bool "Use RTOS task with a direct notification for synchronization"
            default y
            depends on V9_3_LV_OS_FREERTOS
        help
            Unblocking an RTOS task with a direct notification is 45% faster and uses less RAM
            than unblocking a task using an intermediary object such as a binary semaphore.
            RTOS task notifications can only be used when there is only one task that can be the recipient of the event.
	endmenu

	menu "Rendering Configuration"
		config V9_3_LV_DRAW_BUF_STRIDE_ALIGN
			int "Buffer stride alignment"
			default 1
		help
			Align the stride of all layers and images to this bytes.

		config V9_3_LV_DRAW_BUF_ALIGN
			int "Buffer address alignment"
			default 4
		help
			Align the start address of draw_buf addresses to this bytes.

		config V9_3_LV_DRAW_TRANSFORM_USE_MATRIX
			bool "Using matrix for transformations"
			default n
			depends on V9_3_LV_USE_MATRIX
			help
				Requirements: The rendering engine needs to support 3x3 matrix transformations.

		config V9_3_LV_DRAW_LAYER_SIMPLE_BUF_SIZE
			int "Optimal size to buffer the widget with opacity"
			default 24576
			depends on V9_3_LV_USE_DRAW_SW
			help
				If a widget has `style_opa < 255` (not `bg_opa`, `text_opa` etc) or not NORMAL blend mode
				it is buffered into a "simple" layer before rendering. The widget can be buffered in smaller chunks.
				"Transformed layers" (if `transform_angle/zoom` are set) use larger buffers and can't be drawn in chunks.

		config V9_3_LV_DRAW_THREAD_STACK_SIZE
			int "Stack size of draw thread in bytes"
			default 8192
			depends on V9_3_LV_USE_OS > 0
			help
				If FreeType or ThorVG is enabled, it is recommended to set it to 32KB or more.

		config V9_3_LV_USE_DRAW_SW
			bool "Enable software rendering"
			default y
		help
			Required to draw anything on the screen.

		config V9_3_LV_DRAW_SW_SUPPORT_RGB565
			bool "Enable support for RGB565 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_RGB565A8
			bool "Enable support for RGB565A8 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_RGB888
			bool "Enable support for RGB888 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_XRGB8888
			bool "Enable support for XRGB8888 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_ARGB8888
			bool "Enable support for ARGB8888 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_L8
			bool "Enable support for L8 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_AL88
			bool "Enable support for AL88 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_A8
			bool "Enable support for A8 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_SUPPORT_I1
			bool "Enable support for I1 color format"
			default y
			depends on V9_3_LV_USE_DRAW_SW

		config V9_3_LV_DRAW_SW_DRAW_UNIT_CNT
			int "Number of draw units"
			default 1
			depends on V9_3_LV_USE_DRAW_SW
			help
				> 1 requires an operating system enabled in `V9_3_LV_USE_OS`
				> 1 means multiply threads will render the screen in parallel

		config V9_3_LV_USE_DRAW_ARM2D_SYNC
			bool "Enable Arm's 2D image processing library (Arm-2D) for all Cortex-M processors"
			default n
			depends on V9_3_LV_USE_DRAW_SW
			help
				Must deploy arm-2d library to your project and add include PATH for "arm_2d.h".

		config V9_3_LV_USE_NATIVE_HELIUM_ASM
			bool "Enable native helium assembly"
			default n
			depends on V9_3_LV_USE_DRAW_SW
			help
				Disabling this allows arm2d to work on its own (for testing only)

		config V9_3_LV_DRAW_SW_COMPLEX
			bool "Enable complex draw engine"
			default y
			depends on V9_3_LV_USE_DRAW_SW
			help
				0: use a simple renderer capable of drawing only simple rectangles with gradient, images, texts, and straight lines only,
				1: use a complex renderer capable of drawing rounded corners, shadow, skew lines, and arcs too.

		config V9_3_LV_USE_DRAW_SW_COMPLEX_GRADIENTS
			bool "Enable drawing complex gradients in software"
			default n
			depends on V9_3_LV_USE_DRAW_SW
			help
				0: do not enable complex gradients
				1: enable complex gradients (linear at an angle, radial or conical)

		config V9_3_LV_DRAW_SW_SHADOW_CACHE_SIZE
			int "Allow buffering some shadow calculation"
			depends on V9_3_LV_DRAW_SW_COMPLEX
			default 0
			help
				V9_3_LV_DRAW_SW_SHADOW_CACHE_SIZE is the max shadow size to buffer, where
				shadow size is `shadow_width + radius`.
				Caching has V9_3_LV_DRAW_SW_SHADOW_CACHE_SIZE^2 RAM cost.

		config V9_3_LV_DRAW_SW_CIRCLE_CACHE_SIZE
			int "Set number of maximally cached circle data"
			depends on V9_3_LV_DRAW_SW_COMPLEX
			default 4
			help
				The circumference of 1/4 circle are saved for anti-aliasing
				radius * 4 bytes are used per circle (the most often used
				radiuses are saved).
				Set to 0 to disable caching.

		choice V9_3_LV_USE_DRAW_SW_ASM
			prompt "Asm mode in sw draw"
			default V9_3_LV_DRAW_SW_ASM_NONE
			depends on V9_3_LV_USE_DRAW_SW
			help
				ASM mode to be used

			config V9_3_LV_DRAW_SW_ASM_NONE
				bool "0: NONE"
			config V9_3_LV_DRAW_SW_ASM_NEON
				bool "1: NEON"
			config V9_3_LV_DRAW_SW_ASM_HELIUM
				bool "2: HELIUM"
			config V9_3_LV_DRAW_SW_ASM_CUSTOM
				bool "255: CUSTOM"
		endchoice

		config V9_3_LV_USE_DRAW_SW_ASM
			int
			default 0 if V9_3_LV_DRAW_SW_ASM_NONE
			default 1 if V9_3_LV_DRAW_SW_ASM_NEON
			default 2 if V9_3_LV_DRAW_SW_ASM_HELIUM
			default 255 if V9_3_LV_DRAW_SW_ASM_CUSTOM

		config V9_3_LV_DRAW_SW_ASM_CUSTOM_INCLUDE
			string "Set the custom asm include file"
			default ""
			depends on V9_3_LV_DRAW_SW_ASM_CUSTOM

		config V9_3_LV_USE_DRAW_VGLITE
			bool "Use NXP's VG-Lite GPU on iMX RTxxx platforms"
			default n

		config V9_3_LV_USE_VGLITE_BLIT_SPLIT
			bool "Enable blit quality degradation workaround recommended for screen's dimension > 352 pixels"
			depends on V9_3_LV_USE_DRAW_VGLITE
			default n

		config V9_3_LV_USE_VGLITE_DRAW_THREAD
			bool "Use additional draw thread for VG-Lite processing"
			depends on V9_3_LV_USE_DRAW_VGLITE && V9_3_LV_USE_OS > 0
			default y

		config V9_3_LV_USE_VGLITE_DRAW_ASYNC
			bool "Enable VGLite draw async"
			depends on V9_3_LV_USE_VGLITE_DRAW_THREAD
			default y
			help
				Queue multiple tasks and flash them once to the GPU. The task ready state will be send asynchronous to dispatcher.

		config V9_3_LV_USE_VGLITE_ASSERT
			bool "Enable VGLite asserts"
			depends on V9_3_LV_USE_DRAW_VGLITE
			default n

		config V9_3_LV_USE_PXP
		bool "Use NXP's PXP on iMX RTxxx platforms"
		default n
		
		config V9_3_LV_USE_DRAW_PXP
		bool "Use PXP for drawing"
			depends on V9_3_LV_USE_PXP
			default y

		config V9_3_LV_USE_ROTATE_PXP
			bool "Use PXP to rotate display"
			depends on V9_3_LV_USE_PXP
			default n

		config V9_3_LV_USE_PXP_DRAW_THREAD
			bool "Use additional draw thread for PXP processing"
			depends on V9_3_LV_USE_DRAW_PXP && V9_3_LV_USE_OS > 0
			default y

		config V9_3_LV_USE_PXP_ASSERT
			bool "Enable PXP asserts"
			depends on V9_3_LV_USE_DRAW_PXP
			default n

		config V9_3_LV_USE_DRAW_DAVE2D
			bool "Use Renesas Dave2D on RA platforms"
			default n

		config V9_3_LV_USE_DRAW_SDL
			bool "Draw using cached SDL textures"
			default n
			help
				Uses SDL renderer API

		config V9_3_LV_USE_DRAW_VG_LITE
			bool "Use VG-Lite GPU"
			default n
			select V9_3_LV_USE_MATRIX

		config V9_3_LV_VG_LITE_USE_GPU_INIT
			bool "Enable VG-Lite custom external 'gpu_init()' function"
			default n
			depends on V9_3_LV_USE_DRAW_VG_LITE

		config V9_3_LV_VG_LITE_USE_ASSERT
			bool "Enable VG-Lite assert"
			default n
			depends on V9_3_LV_USE_DRAW_VG_LITE

		config V9_3_LV_VG_LITE_FLUSH_MAX_COUNT
			int "VG-Lite flush commit trigger threshold"
			default 8
			depends on V9_3_LV_USE_DRAW_VG_LITE
			help
				GPU will try to batch these many draw tasks

		config V9_3_LV_VG_LITE_USE_BOX_SHADOW
			bool "Enable border to simulate shadow"
			default n
			depends on V9_3_LV_USE_DRAW_VG_LITE
			help
				which usually improves performance,
				but does not guarantee the same rendering quality as the software.

		config V9_3_LV_VG_LITE_GRAD_CACHE_CNT
			int "VG-Lite gradient maximum cache number."
			default 32
			depends on V9_3_LV_USE_DRAW_VG_LITE
			help
				The memory usage of a single gradient:
					linear: 4K bytes.
					radial: radius * 4K bytes.

		config V9_3_LV_VG_LITE_STROKE_CACHE_CNT
			int "VG-Lite stroke maximum cache number."
			default 32
			depends on V9_3_LV_USE_DRAW_VG_LITE

		config V9_3_LV_USE_VECTOR_GRAPHIC
			bool "Use Vector Graphic APIs"
			default n
			select V9_3_LV_USE_MATRIX
			help
				Enable drawing support vector graphic APIs.

		config V9_3_LV_USE_DRAW_DMA2D
			bool "Use DMA2D on the supporting STM32 platforms"
			default n
			help
				Accelerate blends, fills, image decoding, etc. with STM32 DMA2D.

		config V9_3_LV_DRAW_DMA2D_HAL_INCLUDE
			string "the header file for LVGL to include for DMA2D"
			default "stm32h7xx_hal.h"
			depends on V9_3_LV_USE_DRAW_DMA2D

		config V9_3_LV_USE_DRAW_DMA2D_INTERRUPT
			bool "use the DMA2D transfer complete interrupt"
			default n
			depends on V9_3_LV_USE_DRAW_DMA2D
			help
				if enabled, the user is required to call
				`lv_draw_dma2d_transfer_complete_interrupt_handler`
				upon receiving the DMA2D global interrupt

		config V9_3_LV_USE_DRAW_OPENGLES
			bool "Draw using cached OpenGLES textures"
			default n
			depends on V9_3_LV_USE_OPENGLES
	endmenu

	menu "Feature Configuration"
		menu "Logging"
			config V9_3_LV_USE_LOG
				bool "Enable the log module"

			choice
				bool "Default log verbosity" if V9_3_LV_USE_LOG
				default V9_3_LV_LOG_LEVEL_WARN
				help
					Specify how important log should be added.

				config V9_3_LV_LOG_LEVEL_TRACE
					bool "A lot of logs to give detailed information"
				config V9_3_LV_LOG_LEVEL_INFO
					bool "Log important events"
				config V9_3_LV_LOG_LEVEL_WARN
					bool "Log if something unwanted happened but didn't cause a problem"
				config V9_3_LV_LOG_LEVEL_ERROR
					bool "Only critical issues, when the system may fail"
				config V9_3_LV_LOG_LEVEL_USER
					bool "Only logs added by the user"
				config V9_3_LV_LOG_LEVEL_NONE
					bool "Do not log anything"
			endchoice

			config V9_3_LV_LOG_LEVEL
				int
				default 0 if V9_3_LV_LOG_LEVEL_TRACE
				default 1 if V9_3_LV_LOG_LEVEL_INFO
				default 2 if V9_3_LV_LOG_LEVEL_WARN
				default 3 if V9_3_LV_LOG_LEVEL_ERROR
				default 4 if V9_3_LV_LOG_LEVEL_USER
				default 5 if V9_3_LV_LOG_LEVEL_NONE

			config V9_3_LV_LOG_PRINTF
				bool "Print the log with 'printf'" if V9_3_LV_USE_LOG
				help
					Use printf for log output.
					If not set the user needs to register a callback with `lv_log_register_print_cb`.

			config V9_3_LV_LOG_USE_TIMESTAMP
				bool "Enable print timestamp"
				default y
				depends on V9_3_LV_USE_LOG

			config V9_3_LV_LOG_USE_FILE_LINE
				bool "Enable print file and line number"
				default y
				depends on V9_3_LV_USE_LOG

			config V9_3_LV_LOG_TRACE_MEM
				bool "Enable/Disable V9_3_LV_LOG_TRACE in mem module"
				default y
				depends on V9_3_LV_USE_LOG

			config V9_3_LV_LOG_TRACE_TIMER
				bool "Enable/Disable V9_3_LV_LOG_TRACE in timer module"
				default y
				depends on V9_3_LV_USE_LOG

			config V9_3_LV_LOG_TRACE_INDEV
				bool "Enable/Disable V9_3_LV_LOG_TRACE in indev module"
				default y
				depends on V9_3_LV_USE_LOG

			config V9_3_LV_LOG_TRACE_DISP_REFR
				bool "Enable/Disable V9_3_LV_LOG_TRACE in disp refr module"
